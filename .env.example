# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Model provider. Any OpenAI-compatible API that speaks the Responses wire
# format works; these three values are passed straight through to the generated
# Codex provider config.
#
# BytePlus ModelArk (ARK_MODEL is an ep- endpoint ID):
ARK_API_KEY=replace-with-your-model-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Which API dialect the orchestration endpoint (planner/evaluator/etc.) speaks:
#   auto              -> infer from ARK_BASE_URL (openrouter.ai => chat_completions,
#                        else responses). Default.
#   responses         -> OpenAI Responses API (BytePlus ModelArk).
#   chat_completions  -> OpenAI Chat Completions API (OpenRouter, most others).
# Only set this if auto-detection guesses wrong for your provider.
ARK_API_FORMAT=auto

# Leader orchestration knobs. Blank means disabled/unbounded; set a positive
# integer value in milliseconds/counts/tokens to opt into a fuse.
ORCHESTRATION_WORKER_TIMEOUT_MS=
ORCHESTRATION_MODEL_TIMEOUT_MS=

# Bounded self-healing is fail-closed and disabled unless both the feature flag
# and a trusted verifier profile outside candidate-controlled workspaces are
# configured. Exactly one tournament with exactly three branches is enforced.
ORCHESTRATION_HEALING_ENABLED=false
ORCHESTRATION_VERIFICATION_PROFILE=
ORCHESTRATION_MAX_REPAIR_TOURNAMENTS=1
ORCHESTRATION_MAX_REPAIR_BRANCHES=3
ORCHESTRATION_REPAIR_BRANCH_TIMEOUT_MS=240000
ORCHESTRATION_BUDGET_ADVISORY_TOKENS=
ORCHESTRATION_BUDGET_SEVERE_TOKENS=
ORCHESTRATION_BUDGET_ADVISORY_MODEL_CALLS=
ORCHESTRATION_BUDGET_SEVERE_MODEL_CALLS=
ORCHESTRATION_EMERGENCY_TOKEN_FUSE=
ORCHESTRATION_EMERGENCY_MODEL_CALL_FUSE=
ORCHESTRATION_ROOT_TIMEOUT_MS=
ORCHESTRATION_MAX_RUNTIME_STEPS=
ORCHESTRATION_REPEATED_SIGNATURE_LIMIT=
ORCHESTRATION_TRAJECTORY_CHECKPOINT_MS=60000

# Example bounded orchestration profile:
# ORCHESTRATION_WORKER_TIMEOUT_MS=900000
# ORCHESTRATION_MODEL_TIMEOUT_MS=300000
# ORCHESTRATION_BUDGET_ADVISORY_TOKENS=250000
# ORCHESTRATION_BUDGET_SEVERE_TOKENS=1000000
# ORCHESTRATION_BUDGET_ADVISORY_MODEL_CALLS=24
# ORCHESTRATION_BUDGET_SEVERE_MODEL_CALLS=100
# ORCHESTRATION_EMERGENCY_TOKEN_FUSE=10000000
# ORCHESTRATION_EMERGENCY_MODEL_CALL_FUSE=1000
# ORCHESTRATION_ROOT_TIMEOUT_MS=900000
# ORCHESTRATION_MAX_RUNTIME_STEPS=20
# ORCHESTRATION_REPEATED_SIGNATURE_LIMIT=3

# Milestone 3 logical evolution history. This is append-only data under
# APP_DATA_DIR, not a permanent tree of Git workspaces.
ORCHESTRATION_EVOLUTION_MAX_BYTES=1073741824
ORCHESTRATION_EVOLUTION_QUERY_LIMIT=200

# Trusted verification runs in its own bounded container. Candidate workspaces
# are mounted read-only; authority assets are copied and integrity checked.
VERIFIER_CONTAINER_IMAGE=node:22-bookworm-slim
VERIFIER_CONTAINER_CPU_LIMIT=1
VERIFIER_CONTAINER_MEMORY_LIMIT=512m
VERIFIER_CONTAINER_PIDS_LIMIT=64
VERIFIER_CONTAINER_TIMEOUT_MS=60000
VERIFIER_CONTAINER_MAX_OUTPUT_BYTES=1048576
VERIFIER_CONTAINER_USER=65534:65534

#
# OpenRouter instead -- only these two change, and the key above:
#   ARK_MODEL=vendor/model-name
#   ARK_BASE_URL=https://openrouter.ai/api/v1
#
# Codex only ships metadata for OpenAI models. Declare the context window of
# any other model, or Codex guesses and cannot judge when to compact history.
# Codex still reports "Model metadata ... not found" once per turn for any slug
# it does not know; that diagnostic is expected and is not a run failure.
#   ARK_CONTEXT_WINDOW=131072
#
# Cost estimates. Rates are US dollars per million tokens. Leave them unset on
# OpenRouter and they are looked up automatically from the public model list,
# which also supplies the context window above.
#   ARK_PRICE_INPUT=0.04
#   ARK_PRICE_OUTPUT=0.08
#   ARK_PRICE_CACHED_INPUT=0.008
# Set ARK_PRICING_LOOKUP=false to never contact openrouter.ai.

# Runtime paths (Docker defaults are already correct).
# docker-compose.yml sets these in-container itself, and `npm run poc` picks a
# per-user directory on the host and prints it at startup. Uncomment only to
# override both.
#APP_DATA_DIR=/app/data
#AGENT_WORKSPACE_ROOT=/app/workspaces
# Managed Projects are created under AGENT_WORKSPACE_ROOT/projects/<slug>.
# Temporary chats still use AGENT_WORKSPACE_ROOT/<agent-id>. Run worktrees use
# AGENT_WORKSPACE_ROOT/.runs/<run-id>. Local POC defaults these under
# ~/.volc-agent-launchpad/ (macOS) or .local/ (Linux) via start-local-poc.sh.
# Colon-separated on Unix (semicolon-separated on Windows). Open-existing
# repositories must live below one of these roots. Managed Projects under
# AGENT_WORKSPACE_ROOT are always allowed without listing them here.
#WORKSPACE_SOURCE_ROOTS=/app
# Bound individual local Git commands used for source preflight and integration.
GIT_COMMAND_TIMEOUT_MS=15000
#CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
